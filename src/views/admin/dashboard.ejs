<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Dashboard Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>⚙️ Dashboard Admin</h1>
    <div><a href="/">← Retour au forum</a></div>
  </nav>

  <div class="container">

    <h2 style="margin:20px 0 10px">Topics</h2>
    <table class="admin-table">
      <tr>
        <th>ID</th><th>Titre</th><th>Auteur</th><th>État</th><th>Actions</th>
      </tr>
      <% topics.forEach(function(topic) { %>
        <tr>
          <td><%= topic.id %></td>
          <td><a href="/topics/<%= topic.id %>" style="color:#3498db"><%= topic.title %></a></td>
          <td><%= topic.author %></td>
          <td><span class="status-<%= topic.status %>"><%= topic.status %></span></td>
          <td style="display:flex;gap:8px;align-items:center">
            <form method="POST" action="/admin/topics/<%= topic.id %>/status" style="display:flex;gap:5px">
              <select name="status" style="padding:5px;border-radius:4px;border:1px solid #ddd">
                <option value="open" <%= topic.status === 'open' ? 'selected' : '' %>>Ouvert</option>
                <option value="closed" <%= topic.status === 'closed' ? 'selected' : '' %>>Fermé</option>
                <option value="archived" <%= topic.status === 'archived' ? 'selected' : '' %>>Archivé</option>
              </select>
              <button type="submit" class="btn btn-primary" style="padding:5px 10px">OK</button>
            </form>
            <form method="POST" action="/admin/topics/<%= topic.id %>/delete">
              <button type="submit" class="btn btn-danger" style="padding:5px 10px" onclick="return confirm('Supprimer ?')">🗑️</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>

    <h2 style="margin:30px 0 10px">Messages</h2>
    <table class="admin-table">
      <tr>
        <th>ID</th><th>Auteur</th><th>Topic</th><th>Message</th><th>Actions</th>
      </tr>
      <% messages.forEach(function(message) { %>
        <tr>
          <td><%= message.id %></td>
          <td><%= message.author %></td>
          <td><%= message.topic_title %></td>
          <td><%= message.body.substring(0, 50) %>...</td>
          <td>
            <form method="POST" action="/admin/messages/<%= message.id %>/delete">
              <button type="submit" class="btn btn-danger" style="padding:5px 10px" onclick="return confirm('Supprimer ?')">🗑️</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>

    <h2 style="margin:30px 0 10px">Utilisateurs</h2>
    <table class="admin-table">
      <tr>
        <th>ID</th><th>Pseudo</th><th>Email</th><th>Rôle</th><th>Banni</th><th>Actions</th>
      </tr>
      <% users.forEach(function(u) { %>
        <tr>
          <td><%= u.id %></td>
          <td><%= u.username %></td>
          <td><%= u.email %></td>
          <td><%= u.role %></td>
          <td><%= u.is_banned ? '✅ Oui' : 'Non' %></td>
          <td>
            <% if (!u.is_banned) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/ban">
                <button type="submit" class="btn btn-danger" style="padding:5px 10px" onclick="return confirm('Bannir ?')">🚫 Bannir</button>
              </form>
            <% } else { %>
              <form method="POST" action="/admin/users/<%= u.id %>/unban">
                <button type="submit" class="btn btn-success" style="padding:5px 10px">✅ Débannir</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>

  </div>
</body>
</html>