<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title><%= topic.title %></title>
</head>
<body>
  <a href="/">← Retour</a>
  <h1><%= topic.title %></h1>
  <p>Par <strong><%= topic.username %></strong> | <%= new Date(topic.created_at).toLocaleDateString('fr-FR') %></p>
  <p>Tags : <%= topic.tags || 'Aucun' %></p>
  <p>État : <%= topic.status %></p>
  <hr>
  <p><%= topic.body %></p>
  <hr>

  <h2>Messages (<%= messages.length %>)</h2>

  <form method="GET" action="/topics/<%= topic.id %>">
  <label>Trier par :</label>
  <select name="sort" onchange="this.form.submit()">
    <option value="date" <%= sort === 'date' ? 'selected' : '' %>>Plus récent</option>
    <option value="popularity" <%= sort === 'popularity' ? 'selected' : '' %>>Popularité</option>
  </select>
</form>
<div>
  <label>Afficher par : </label>
  <% limitOptions.forEach(function(l) { %>
    <a href="/topics/<%= topic.id %>?sort=<%= sort %>&limit=<%= l %>&page=1"><%= l %></a> |
  <% }) %>
  <a href="/topics/<%= topic.id %>?sort=<%= sort %>&all=1">Tout</a>
</div>

<% if (!all) { %>
  <div>
    <% if (page > 1) { %>
      <a href="/topics/<%= topic.id %>?sort=<%= sort %>&limit=<%= limit %>&page=<%= page - 1 %>">← Précédent</a>
    <% } %>
    Page <%= page %> / <%= totalPages %>
    <% if (page < totalPages) { %>
      <a href="/topics/<%= topic.id %>?sort=<%= sort %>&limit=<%= limit %>&page=<%= page + 1 %>">Suivant →</a>
    <% } %>
  </div>
<% } %>
  <% messages.forEach(function(message) { %>
    <div style="border:1px solid #ccc; padding:10px; margin:10px 0;">
      <p><strong><%= message.username %></strong> | <%= new Date(message.sent_at).toLocaleDateString('fr-FR') %></p>
      <p><%= message.body %></p>
      <<p>
  <form method="POST" action="/topics/<%= topic.id %>/messages/<%= message.id %>/react" style="display:inline;">
    <input type="hidden" name="type" value="like">
    <button type="submit">👍 <%= message.likes %></button>
  </form>
  <form method="POST" action="/topics/<%= topic.id %>/messages/<%= message.id %>/react" style="display:inline;">
    <input type="hidden" name="type" value="dislike">
    <button type="submit">👎 <%= message.dislikes %></button>
  </form>
</p>

      <% if (user && (user.id === topic.author_id || user.id === message.author_id || user.role === 'admin')) { %>
        <form method="POST" action="/topics/<%= topic.id %>/messages/<%= message.id %>/delete">
          <button type="submit">🗑️ Supprimer</button>
        </form>
      <% } %>
    </div>
  <% }) %>

  <hr>
  <% if (user && topic.status === 'open') { %>
    <h3>Poster un message</h3>
    <form method="POST" action="/topics/<%= topic.id %>/messages">
      <textarea name="body" rows="4" cols="50" placeholder="Votre message..." required></textarea><br><br>
      <button type="submit">Envoyer</button>
    </form>
  <% } else if (!user) { %>
    <p><a href="/login">Connecte-toi</a> pour poster un message.</p>
  <% } else if (topic.status === 'closed') { %>
    <p>Ce topic est fermé, impossible de poster.</p>
  <% } %>
</body>
</html>