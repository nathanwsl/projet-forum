<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Créer un topic</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>💬 Forum</h1>
    <div><a href="/">← Retour</a></div>
  </nav>

  <div class="form-card" style="max-width:700px">
    <h1>Créer un topic</h1>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/topics/create">
      <div class="form-group">
        <label>Titre</label>
        <input type="text" name="title" required />
      </div>
      <div class="form-group">
        <label>Corps</label>
        <textarea name="body" rows="8" required></textarea>
      </div>
      <div class="form-group">
        <label>Tags (séparés par des virgules)</label>
        <input type="text" name="tags" placeholder="ex: javascript, aide, question" />
      </div>
      <button type="submit" class="btn btn-primary">Créer le topic</button>
    </form>
  </div>
</body>
</html>