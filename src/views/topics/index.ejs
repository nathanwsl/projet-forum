<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Forum</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <nav class="navbar">
  <h1>💬 Forum</h1>
  <div>
    <% if (user) { %>
      <a href="/profile/<%= user.id %>">👤 <%= user.username %></a>
      <a href="/topics/create" class="btn btn-primary" style="margin-left:15px">+ Nouveau topic</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin">⚙️ Admin</a>
      <% } %>
      <a href="/settings">Paramètres</a>
      <a href="/logout">Déconnexion</a>
    <% } else { %>
      <a href="/login">Se connecter</a>
      <a href="/register">S'inscrire</a>
    <% } %>
  </div>
</nav>

  <div class="container">

    <div class="search-bar">
      <form method="GET" action="/" style="display:flex;gap:10px;width:100%">
        <input type="text" name="search" placeholder="🔍 Rechercher un topic..." value="<%= search %>" />
        <button type="submit" class="btn btn-primary">Rechercher</button>
      </form>
    </div>

    <div style="margin-bottom:15px">
      <strong>Tags : </strong>
      <a href="/" class="tag">Tous</a>
      <% tags.forEach(function(t) { %>
        <a href="/?tag=<%= t.name %>" class="tag"><%= t.name %></a>
      <% }) %>
    </div>

    <h2 style="margin-bottom:15px">Topics</h2>

    <% if (search) { %><p style="margin-bottom:10px">Résultats pour : "<%= search %>"</p><% } %>
    <% if (tag) { %><p style="margin-bottom:10px">Tag : "<%= tag %>"</p><% } %>

    <% if (topics.length === 0) { %>
      <p>Aucun topic trouvé.</p>
    <% } %>

    <% topics.forEach(function(topic) { %>
      <div class="topic-card">
        <h3><a href="/topics/<%= topic.id %>"><%= topic.title %></a></h3>
        <div class="topic-meta">
          Par <strong><a href="/profile/<%= topic.author_id %>" style="text-decoration:none;color:#2c3e50"><%= topic.username %></a></strong> | <%= new Date(topic.created_at).toLocaleDateString('fr-FR') %>
          <span class="status-<%= topic.status %>"><%= topic.status %></span>
        </div>
        <div style="margin-top:8px">
          <% if (topic.tags) { %>
            <% topic.tags.split(', ').forEach(function(tag) { %>
              <a href="/?tag=<%= tag %>" class="tag"><%= tag %></a>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% }) %>

    <div class="pagination">
      <span>Afficher par :</span>
      <% limitOptions.forEach(function(l) { %>
        <a href="/?limit=<%= l %>&page=1&search=<%= search %>&tag=<%= tag %>"><%= l %></a>
      <% }) %>
      <a href="/?all=1&search=<%= search %>&tag=<%= tag %>">Tout</a>
      <% if (!all) { %>
        <% if (page > 1) { %>
          <a href="/?limit=<%= limit %>&page=<%= page - 1 %>&search=<%= search %>&tag=<%= tag %>">← Précédent</a>
        <% } %>
        <span>Page <%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/?limit=<%= limit %>&page=<%= page + 1 %>&search=<%= search %>&tag=<%= tag %>">Suivant →</a>
        <% } %>
      <% } %>
    </div>

  </div>
</body>
</html>