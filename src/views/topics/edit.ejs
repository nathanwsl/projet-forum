<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Modifier le topic</title>
</head>
<body>
  <h1>Modifier le topic</h1>
  <% if (error) { %>
    <p style="color:red;"><%= error %></p>
  <% } %>
  <form method="POST" action="/topics/<%= topic.id %>/edit">
    <label>Titre :</label><br>
    <input type="text" name="title" value="<%= topic.title %>" required /><br><br>
    <label>Corps :</label><br>
    <textarea name="body" rows="6" cols="50" required><%= topic.body %></textarea><br><br>
    <label>Tags (séparés par des virgules) :</label><br>
    <input type="text" name="tags" value="<%= topic.tags || '' %>" /><br><br>
    <button type="submit">Modifier</button>
  </form>
  <a href="/topics/<%= topic.id %>">Annuler</a>
</body>
</html>