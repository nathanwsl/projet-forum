<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Paramètres</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>💬 Forum</h1>
    <div>
      <a href="/">← Retour</a>
      <a href="/logout">Déconnexion</a>
    </div>
  </nav>

  <div class="form-card" style="max-width:600px">
    <h1>⚙️ Paramètres du profil</h1>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div style="background:#eafaf1;color:#2ecc71;padding:10px;border-radius:5px;margin-bottom:15px"><%= success %></div>
    <% } %>

    <div style="display:flex;align-items:center;gap:20px;margin-bottom:20px">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="avatar" style="width:80px;height:80px;border-radius:50%;object-fit:cover">
      <% } else { %>
        <div style="width:80px;height:80px;border-radius:50%;background:#3498db;display:flex;align-items:center;justify-content:center;font-size:30px;color:white">
          <%= user.username[0].toUpperCase() %>
        </div>
      <% } %>
      <div>
        <strong><%= user.username %></strong><br>
        <small style="color:#888"><%= user.email %></small>
      </div>
    </div>

    <form method="POST" action="/settings" enctype="multipart/form-data">
      <div class="form-group">
        <label>Photo de profil</label>
        <input type="file" name="avatar" accept="image/*" />
        <small style="color:#888">JPG, PNG, GIF - Max 2MB</small>
      </div>
      <div class="form-group">
        <label>Biographie</label>
        <textarea name="bio" rows="4" placeholder="Parlez-nous de vous..."><%= user.bio || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Sauvegarder</button>
    </form>
  </div>
</body>
</html>