<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Forum</title>
</head>
<body>
  <h1>Bienvenue sur le Forum</h1>
  <% if (user) { %>
    <p>Connecté en tant que : <strong><%= user.username %></strong></p>
    <a href="/logout">Se déconnecter</a>
  <% } else { %>
    <a href="/login">Se connecter</a> | <a href="/register">S'inscrire</a>
  <% } %>
</body>
</html>